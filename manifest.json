{
  "manifest_version": 3,
  "name": "Tab Video Recorder",
  "version": "1.1.0",
  "description": "Grava o vídeo e o áudio interno de uma aba e para automaticamente quando o vídeo termina.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "downloads",
    "offscreen",
    "scripting",
    "storage",
    "tabCapture"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Video Recorder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
